# Optional overrides for docker compose: copy to .env and edit.
# Host directories holding state that must survive container rebuilds:
DUOSAVE_DATA_DIR=./data
DUOSAVE_PICTURES_DIR=./pictures
DUOSAVE_SCREENS_DIR=./screens
DUOSAVE_SCREENS_RAW_DIR=./screens_raw

# Published port of the site (http://localhost:<port>):
DUOSAVE_PORT=8765

# Commit and repository URL shown in the site header (useful for builds without a checkout):
# DUOSAVE_COMMIT=abc1234
# DUOSAVE_REPO_URL=https://github.com/northis/duosave
