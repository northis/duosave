# Optional overrides for docker compose: copy to .env and edit.
# Host directories holding state that must survive container rebuilds:
DUOSAVE_DATA_DIR=./data
DUOSAVE_PICTURES_DIR=./pictures
DUOSAVE_SCREENS_DIR=./screens
DUOSAVE_SCREENS_RAW_DIR=./screens_raw

# Published port of the site (http://localhost:<port>):
DUOSAVE_PORT=8765
# Publish the site on one interface only, e.g. the VPN address (Traefik reaches it there):
# DUOSAVE_BIND_ADDR=10.77.77.21

# Maintenance listener: reachable only from the local network (VPN/LAN), never from the
# internet. The compose default is the VPN address; use 127.0.0.1 to keep it on this machine.
# If the VPN adapter has no address at container start, the port cannot be bound: connect
# the VPN first, or set 127.0.0.1.
# DUOSAVE_ADMIN_BIND_ADDR=10.77.77.21
DUOSAVE_ADMIN_PORT=8766

# Repository URL shown in the site header (useful for builds without a checkout):
# DUOSAVE_REPO_URL=https://github.com/northis/duosave

# Build args for a manual `docker compose build` (the updater passes them itself):
# DUOSAVE_COMMIT=abc1234
# DUOSAVE_COMMIT_DATE=2026-10-12T10:00:00+03:00

# Patch upload limit in MB (default 100):
# DUOSAVE_PATCH_MAX_MB=100
