# Runtime state and source images are mounted from the host, never baked into the image.
data/
pictures/
screens/
screens_raw/
exports/
review_queue.jsonl
inbox/
outbox/

# Host-side tooling and agent docs: not needed inside the container.
deploy/
.agents/
AGENTS.md
requirements-agent.txt

# Git metadata: the builder gets only HEAD and the refs, never history or objects. The image
# resolves its commit from them (duosave/buildinfo.py) when DUOSAVE_COMMIT is not passed — that
# is how a plain `docker compose up -d --build` after `git pull` stamps the new commit.
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs/

# Local development artifacts.
.gitignore
.gitattributes
.sdd/
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
venv/
.idea/
.vscode/
tests/
